generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  completed   Boolean  @default(false)
  priority    String
  category    String
  dueDate     DateTime
  createdAt   DateTime @default(now())
  deleted     Boolean  @default(false)
  completedAt DateTime? 
}
